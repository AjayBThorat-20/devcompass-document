# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.swc/

# editor
/.vscode/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/test

# claude code
.claude

# auto-generated on every `next dev` run (see node_modules/next/dist/server/lib/generate-agent-files.js) —
# ignored rather than committed so the working tree never shows them as dirty
/AGENTS.md
/CLAUDE.md